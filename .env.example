SESSION_SECRET=replace-with-a-long-random-secret

# Supabase Auth and database (server-side only; never expose these publicly)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional aliases accepted for Supabase Auth URL/anon key.
# The service-role key must remain server-only and must never use NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel KV (legacy prototype storage; do not use for new patient data)
KV_REST_API_URL=
KV_REST_API_TOKEN=
